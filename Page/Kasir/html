<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriPOS — Sistem Kasir Pertanian & Sinkronisasi Gudang</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        agri: {
                            50: '#f2fbf5',
                            100: '#e1f7e8',
                            200: '#c4edd2',
                            300: '#96deaf',
                            400: '#5fc684',
                            500: '#38ab63',
                            600: '#278b4d',
                            700: '#216e3f',
                            800: '#1e5835',
                            900: '#1a482d',
                            950: '#0d2718',
                        },
                        earth: {
                            50: '#faf8f5',
                            100: '#f3efe6',
                            200: '#e6decb',
                            800: '#5c4d3c',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f2fbf5;
        }
        ::-webkit-scrollbar-thumb {
            background: #96deaf;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #38ab63;
        }

        .agri-bg {
            background-color: #f6faf7;
            background-image: radial-gradient(#278b4d12 1px, transparent 1px);
            background-size: 20px 20px;
        }

        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            100% { transform: scale(2.1); opacity: 0; }
        }
        .pulse-dot::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 9999px;
            background-color: #22c55e;
            animation: pulse-ring 1.8s cubic-bezier(0.24, 0, 0.38, 1) infinite;
        }

        @media print {
            body * {
                visibility: hidden;
            }
            #printable-receipt, #printable-receipt * {
                visibility: visible;
            }
            #printable-receipt {
                position: fixed;
                left: 0;
                top: 0;
                width: 100%;
                box-shadow: none !important;
                border: none !important;
            }
        }
    </style>
</head>
<body class="agri-bg text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- =========================================================================
         TOP NAVIGATION BAR (SAAS HEADER)
    ========================================================================== -->
    <header class="bg-agri-950 text-white px-4 sm:px-6 py-3 sticky top-0 z-30 shadow-md border-b border-agri-800">
        <div class="max-w-[1600px] mx-auto flex flex-wrap items-center justify-between gap-3">
            <!-- Brand & Module Title -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-agri-400 to-agri-600 flex items-center justify-center shadow-lg shadow-agri-900/50">
                    <i data-lucide="sprout" class="w-5 h-5 text-white"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-extrabold text-base sm:text-lg tracking-tight leading-none">AgriPOS <span class="text-agri-300 font-semibold">Terminal</span></h1>
                        <span class="hidden sm:inline-block text-[10px] uppercase tracking-wider bg-agri-800 text-agri-200 px-2 py-0.5 rounded-full font-bold">Bagian C — Kasir</span>
                    </div>
                    <p class="text-[11px] text-agri-300 mt-0.5">Toko Saprotan & Hasil Tani Sejahtera</p>
                </div>
            </div>

            <!-- Live Warehouse Sync Status & History Button -->
            <div class="flex items-center gap-2.5 sm:gap-4">
                <!-- Sync Indicator -->
                <div class="flex items-center gap-2 bg-agri-900/90 border border-agri-700/70 px-3 py-1.5 rounded-xl">
                    <span class="relative flex h-2.5 w-2.5">
                        <span class="pulse-dot relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
                    </span>
                    <div class="text-xs">
                        <span id="sync-status-label" class="font-semibold text-emerald-300 block leading-none">Gudang Terhubung</span>
                        <span id="sync-last-time" class="text-[10px] text-agri-300 font-mono">Sinkron Real-Time</span>
                    </div>
                    <button onclick="requestWarehouseCatalog()" title="Minta Ulang Data Terbaru dari Gudang" class="ml-1 p-1 rounded-lg hover:bg-agri-800 text-agri-200 hover:text-white transition">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                    </button>
                </div>

                <!-- Transaction History Button -->
                <button onclick="openHistoryModal()" class="px-3 py-2 bg-agri-800 hover:bg-agri-700 text-white text-xs font-semibold rounded-xl transition flex items-center gap-1.5 border border-agri-700">
                    <i data-lucide="receipt" class="w-4 h-4 text-agri-300"></i>
                    <span class="hidden sm:inline">Riwayat Transaksi</span>
                    <span id="tx-history-count" class="bg-agri-600 text-white font-mono text-[11px] px-1.5 py-0.2 rounded-full">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- =========================================================================
         MAIN SPLIT WORKSPACE: KIRI (KATALOG VISUAL) & KANAN (CRM + KERANJANG POS)
    ========================================================================== -->
    <main class="flex-1 max-w-[1600px] w-full mx-auto p-4 sm:p-5 grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

        <!-- =====================================================================
             KOLOM KIRI (7 KOLOM): SCANNER BARCODE & KATALOG VISUAL PRODUK
        ====================================================================== -->
        <section class="lg:col-span-7 xl:col-span-8 space-y-4">
            
            <!-- Scan Barcode / Quick Search Bar -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-sm space-y-3">
                <div class="flex flex-col sm:flex-row gap-2.5">
                    <!-- Barcode / SKU Direct Scan Input -->
                    <form onsubmit="handleBarcodeScan(event)" class="relative flex-1">
                        <i data-lucide="scan-barcode" class="w-4 h-4 text-agri-600 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="barcode-scan-input" placeholder="Scan Kode Khusus / SKU lalu tekan Enter (Contoh: BNH-PADI-32)..." class="w-full pl-10 pr-20 py-2.5 text-sm font-mono bg-agri-50/60 border border-agri-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-agri-500 focus:bg-white transition">
                        <button type="submit" class="absolute right-1.5 top-1/2 -translate-y-1/2 px-2.5 py-1 bg-agri-600 hover:bg-agri-700 text-white text-xs font-bold rounded-lg transition">
                            Tambah
                        </button>
                    </form>

                    <!-- Filter Visual Catalog -->
                    <div class="relative sm:w-64">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="catalog-search-input" oninput="renderCatalog()" placeholder="Cari nama produk..." class="w-full pl-9 pr-4 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-agri-500 focus:bg-white transition">
                    </div>
                </div>

                <!-- Category Filter Pills -->
                <div class="flex items-center justify-between flex-wrap gap-2 pt-1">
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1">
                        <button onclick="setCatalogFilter('all')" id="cat-all" class="cat-pill px-3 py-1 rounded-full text-xs font-bold bg-agri-600 text-white transition">Semua Produk</button>
                        <button onclick="setCatalogFilter('available')" id="cat-available" class="cat-pill px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">Stok Rak Tersedia</button>
                        <button onclick="setCatalogFilter('low')" id="cat-low" class="cat-pill px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition">Stok Menipis</button>
                    </div>
                    <span class="text-[11px] text-slate-500 flex items-center gap-1">
                        <i data-lucide="info" class="w-3.5 h-3.5 text-agri-600"></i> Klik kartu produk untuk masuk ke keranjang
                    </span>
                </div>
            </div>

            <!-- Visual Catalog Grid (Moka POS Style) -->
            <div id="visual-catalog-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3.5">
                <!-- Populated dynamically via JS -->
            </div>
        </section>

        <!-- =====================================================================
             KOLOM KANAN (5 KOLOM): IDENTIFIKASI PELANGGAN (CRM) & CHECKOUT KASIR
        ====================================================================== -->
        <aside class="lg:col-span-5 xl:col-span-4 bg-white rounded-2xl border border-slate-200/90 shadow-md overflow-hidden sticky top-20 flex flex-col">
            
            <!-- STEP 1: IDENTIFIKASI PELANGGAN (CRM) -->
            <div class="p-4 bg-earth-50 border-b border-earth-200 space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                        <i data-lucide="user-check" class="w-4 h-4 text-agri-600"></i> 1. Identifikasi Pelanggan (CRM)
                    </span>
                    <button onclick="openCrmModal()" class="text-xs font-bold text-agri-700 hover:text-agri-900 underline flex items-center gap-1">
                        <i data-lucide="user-plus" class="w-3.5 h-3.5"></i> Member / Daftar Baru
                    </button>
                </div>

                <!-- Selected Customer Card -->
                <div id="selected-customer-card" class="bg-white p-3 rounded-xl border border-earth-200 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div id="crm-avatar" class="w-9 h-9 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs flex-shrink-0">
                            UM
                        </div>
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5">
                                <p id="crm-name" class="text-xs font-bold text-slate-900 truncate">Pelanggan Umum (Lewati)</p>
                                <span id="crm-badge" class="hidden px-1.5 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-800 rounded">Member</span>
                            </div>
                            <p id="crm-phone" class="text-[11px] text-slate-500 font-mono truncate">Tanpa diskon khusus member</p>
                        </div>
                    </div>
                    <button onclick="openCrmModal()" class="px-2.5 py-1.5 bg-agri-50 hover:bg-agri-100 text-agri-700 text-xs font-bold rounded-lg border border-agri-200 flex-shrink-0">
                        Pilih
                    </button>
                </div>
            </div>

            <!-- STEP 2: DAFTAR ITEM TRANSAKSI (KERANJANG) -->
            <div class="p-4 flex-1 flex flex-col justify-between space-y-4">
                <div>
                    <div class="flex items-center justify-between mb-2.5">
                        <span class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-1.5">
                            <i data-lucide="shopping-bag" class="w-4 h-4 text-agri-600"></i> 2. Detail Pesanan (<span id="cart-item-count">0</span>)
                        </span>
                        <button onclick="clearCart()" id="btn-clear-cart" class="text-xs text-rose-600 hover:text-rose-800 font-semibold hidden">
                            Kosongkan
                        </button>
                    </div>

                    <!-- Cart Items List -->
                    <div id="cart-items-container" class="space-y-2.5 max-h-[300px] overflow-y-auto pr-1">
                        <!-- Empty State -->
                        <div class="py-10 text-center border-2 border-dashed border-slate-200 rounded-xl">
                            <i data-lucide="shopping-cart" class="w-8 h-8 text-slate-300 mx-auto mb-2"></i>
                            <p class="text-xs font-semibold text-slate-500">Keranjang belanja masih kosong</p>
                            <p class="text-[11px] text-slate-400 mt-0.5">Pilih barang dari katalog atau scan kode khusus</p>
                        </div>
                    </div>
                </div>

                <!-- STEP 3: RINGKASAN HARGA, DISKON & PAJAK -->
                <div class="border-t border-slate-200 pt-3.5 space-y-2.5">
                    <!-- Custom / Member Discount Row -->
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-slate-600 flex items-center gap-1.5">
                            Diskon Member / Khusus (%)
                        </span>
                        <div class="flex items-center gap-1.5">
                            <input type="number" id="discount-percent-input" min="0" max="100" value="0" oninput="recalculateTotals()" class="w-16 px-2 py-1 text-right font-mono font-bold text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-agri-500">
                            <span class="text-slate-500 font-bold">%</span>
                        </div>
                    </div>

                    <!-- Tax Toggle (PPN 11% Optional) -->
                    <div class="flex items-center justify-between text-xs">
                        <label class="flex items-center gap-2 text-slate-600 cursor-pointer">
                            <input type="checkbox" id="tax-toggle" onchange="recalculateTotals()" class="rounded text-agri-600 focus:ring-agri-500">
                            <span>Sertakan PPN (11%)</span>
                        </label>
                        <span id="summary-tax" class="font-mono text-slate-700">Rp 0</span>
                    </div>

                    <div class="flex items-center justify-between text-xs text-slate-600">
                        <span>Subtotal</span>
                        <span id="summary-subtotal" class="font-mono font-semibold text-slate-800">Rp 0</span>
                    </div>

                    <div class="flex items-center justify-between text-xs text-emerald-700">
                        <span>Potongan Diskon</span>
                        <span id="summary-discount" class="font-mono font-semibold">- Rp 0</span>
                    </div>

                    <div class="bg-agri-50 border border-agri-200 rounded-xl p-3 flex items-center justify-between">
                        <span class="text-sm font-extrabold text-agri-950">TOTAL BAYAR</span>
                        <span id="summary-grand-total" class="text-xl font-extrabold font-mono text-agri-700">Rp 0</span>
                    </div>

                    <!-- CTA BUTTON: PROSES PEMBAYARAN -->
                    <button onclick="openPaymentModal()" id="btn-checkout" disabled class="w-full py-3.5 px-4 bg-agri-600 hover:bg-agri-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-extrabold text-sm rounded-xl shadow-lg shadow-agri-600/20 transition flex items-center justify-center gap-2">
                        <i data-lucide="credit-card" class="w-4 h-4"></i>
                        <span>Lanjut ke Pembayaran</span>
                    </button>
                </div>
            </div>
        </aside>

    </main>

    <!-- =========================================================================
         MODAL 1: CRM PELANGGAN (PILIH MEMBER / DAFTARKAN PELANGGAN BARU)
    ========================================================================== -->
    <div id="crm-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden">
            <div class="px-5 py-4 bg-agri-900 text-white flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i data-lucide="users" class="w-5 h-5 text-agri-300"></i>
                    <div>
                        <h3 class="font-bold text-base">Database Pelanggan & Member (CRM)</h3>
                        <p class="text-xs text-agri-300">Identifikasi member untuk diskon & kirim struk WhatsApp</p>
                    </div>
                </div>
                <button onclick="closeCrmModal()" class="p-1.5 rounded-lg hover:bg-agri-800 text-agri-200">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <div class="p-5 space-y-4 max-h-[80vh] overflow-y-auto">
                <!-- Search Existing Member -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">Cari Pelanggan Terdaftar (Nama / No. HP / ID)</label>
                    <input type="text" id="crm-search-input" oninput="renderCustomerList()" placeholder="Ketik nama petani atau nomor WhatsApp..." class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-agri-500">
                </div>

                <!-- Member List -->
                <div id="crm-member-list" class="space-y-2 max-h-48 overflow-y-auto">
                    <!-- Populated via JS -->
                </div>

                <!-- Divider -->
                <div class="relative flex py-1 items-center">
                    <div class="flex-grow border-t border-slate-200"></div>
                    <span class="flex-shrink mx-3 text-[11px] font-bold text-slate-400 uppercase">Atau Daftarkan Pelanggan Baru</span>
                    <div class="flex-grow border-t border-slate-200"></div>
                </div>

                <!-- Register New Customer Form -->
                <form onsubmit="handleRegisterCustomer(event)" class="bg-agri-50/70 border border-agri-200 rounded-xl p-3.5 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-700 mb-1">Nama Pelanggan *</label>
                            <input type="text" id="new-cust-name" required placeholder="Pak Budi Santoso" class="w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-agri-500">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-700 mb-1">No. WhatsApp (Untuk Struk) *</label>
                            <input type="tel" id="new-cust-phone" required placeholder="081234567890" class="w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-agri-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-700 mb-1">Alamat / Kelompok Tani (Opsional - Untuk Antar Barang)</label>
                        <input type="text" id="new-cust-address" placeholder="Desa Sukamaju RT 02 / Gapoktan Tani Makmur" class="w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-agri-500">
                    </div>
                    <div class="flex items-center justify-between pt-1">
                        <button type="button" onclick="selectGuestCustomer()" class="text-xs font-semibold text-slate-500 hover:text-slate-800 underline">
                            Lewati (Pelanggan Umum)
                        </button>
                        <button type="submit" class="px-4 py-2 bg-agri-600 hover:bg-agri-700 text-white text-xs font-bold rounded-lg shadow transition">
                            Simpan & Pilih Pelanggan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         MODAL 2: PROSES PEMBAYARAN (TUNAI & PAYMENT GATEWAY NON-TUNAI)
    ========================================================================== -->
    <div id="payment-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden">
            <div class="px-5 py-4 bg-agri-900 text-white flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-base">Metode Pembayaran</h3>
                    <p class="text-xs text-agri-300">Pilih pembayaran Tunai atau Non-Tunai</p>
                </div>
                <button onclick="closePaymentModal()" class="p-1.5 rounded-lg hover:bg-agri-800 text-agri-200">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <!-- Grand Total Display -->
                <div class="bg-agri-50 border border-agri-200 rounded-xl p-4 text-center">
                    <span class="text-xs font-semibold text-agri-800 uppercase tracking-wider">Total Tagihan</span>
                    <p id="pay-modal-total" class="text-3xl font-extrabold font-mono text-agri-700 mt-1">Rp 0</p>
                </div>

                <!-- Payment Method Tabs -->
                <div class="grid grid-cols-2 gap-2.5">
                    <button type="button" onclick="switchPaymentMethod('cash')" id="pay-tab-cash" class="p-3 rounded-xl border-2 border-agri-600 bg-agri-50 text-agri-900 font-bold text-xs flex flex-col items-center gap-1.5 transition">
                        <i data-lucide="banknote" class="w-5 h-5 text-agri-600"></i>
                        <span>Option 1: Tunai</span>
                    </button>
                    <button type="button" onclick="switchPaymentMethod('gateway')" id="pay-tab-gateway" class="p-3 rounded-xl border-2 border-slate-200 bg-white text-slate-600 font-bold text-xs flex flex-col items-center gap-1.5 transition">
                        <i data-lucide="qr-code" class="w-5 h-5 text-sky-600"></i>
                        <span>Option 2: QRIS / Kartu</span>
                    </button>
                </div>

                <!-- OPTION 1: CASH INPUT -->
                <div id="payment-cash-section" class="space-y-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Uang Tunai Diterima (Rp)</label>
                        <input type="number" id="cash-received-input" oninput="calculateChange()" class="w-full px-3.5 py-2.5 text-lg font-mono font-bold border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-agri-500">
                    </div>

                    <!-- Quick Cash Buttons -->
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" onclick="setExactCash()" class="py-1.5 px-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg">Uang Pas</button>
                        <button type="button" onclick="addCashAmount(50000)" class="py-1.5 px-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-mono font-bold rounded-lg">+50.000</button>
                        <button type="button" onclick="addCashAmount(100000)" class="py-1.5 px-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-mono font-bold rounded-lg">+100.000</button>
                    </div>

                    <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200">
                        <span class="text-xs font-semibold text-slate-600">Kembalian:</span>
                        <span id="cash-change-display" class="text-base font-extrabold font-mono text-slate-900">Rp 0</span>
                    </div>

                    <button type="button" onclick="completeTransaction('Tunai')" id="btn-confirm-cash" class="w-full py-3 bg-agri-600 hover:bg-agri-700 text-white font-extrabold text-sm rounded-xl shadow transition flex items-center justify-center gap-2">
                        <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                        <span>Catat Lunas & Selesaikan Transaksi</span>
                    </button>
                </div>

                <!-- OPTION 2: PAYMENT GATEWAY (QRIS / E-WALLET / KARTU) -->
                <div id="payment-gateway-section" class="hidden space-y-3 text-center">
                    <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-2">
