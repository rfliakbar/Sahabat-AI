    <!-- TOAST CONTAINER -->
    <div id="toast-container" class="fixed bottom-4 left-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- =========================================================================
         JAVASCRIPT LOGIC & SINKRONISASI REAL-TIME KE GUDANG
    ========================================================================== -->
    <script>
        /**
         * 1. STATE PRODUK (TERHUBUNG DENGAN GUDANG AGRISTOCK WMS)
         * Data ini akan otomatis diperbarui ketika Staff Gudang menambah/mengubah barang
         * di tab/jendela Gudang via BroadcastChannel('agristock_pos_sync').
         */
        let catalogProducts = [
            {
                id: 'PRD-1001',
                sku: 'BNH-PADI-32',
                name: 'Benih Padi Unggul Inpari 32 (5kg)',
                price: 75000,
                image: 'https://placehold.co/400x300/278b4d/ffffff?text=Benih+Padi+Inpari+32',
                availableStock: 85,
                shelfStock: 14
            },
            {
                id: 'PRD-1002',
                sku: 'PPK-NPK-16',
                name: 'Pupuk NPK Mutiara 16-16-16 (1kg)',
                price: 22000,
                image: 'https://placehold.co/400x300/38ab63/ffffff?text=Pupuk+NPK+Mutiara',
                availableStock: 140,
                shelfStock: 5
            },
            {
                id: 'PRD-1003',
                sku: 'PST-ORG-500',
                name: 'Pestisida Nabati Neem Oil 500ml',
                price: 48000,
                image: 'https://placehold.co/400x300/1e5835/ffffff?text=Pestisida+Nabati',
                availableStock: 42,
                shelfStock: 11
            },
            {
                id: 'PRD-1004',
                sku: 'ALT-SPRY-16L',
                name: 'Tangki Sprayer Elektrik Pertanian 16L',
                price: 465000,
                image: 'https://placehold.co/400x300/216e3f/ffffff?text=Sprayer+Elektrik+16L',
                availableStock: 12,
                shelfStock: 2
            }
        ];

        // Database CRM Pelanggan
        let crmCustomers = [
            { id: 'MBR-001', name: 'H. Slamet Riyadi (Gapoktan Makmur)', phone: '081228901122', address: 'Desa Wonosari', isMember: true, discount: 5, points: 320 },
            { id: 'MBR-002', name: 'Ibu Siti Aminah', phone: '085741229900', address: 'Kec. Banyumanik', isMember: true, discount: 5, points: 150 },
            { id: 'MBR-003', name: 'Pak Joko Susilo', phone: '081390887766', address: 'Desa Karangjati', isMember: true, discount: 10, points: 640 }
        ];

        let selectedCustomer = null; // null = Pelanggan Umum
        let cart = []; // { sku, name, price, image, qty, maxStock }
        let catalogFilter = 'all';
        let transactionHistory = [];
        let lastCompletedReceipt = null;

        /**
         * 2. JEMBATAN KOMUNIKASI REAL-TIME DENGAN SISTEM GUDANG
         */
        const posSyncChannel = new BroadcastChannel('agristock_pos_sync');

        // Terima data katalog terbaru dari Gudang secara otomatis
        posSyncChannel.onmessage = (event) => {
            const data = event.data;
            if (!data) return;

            if (Array.isArray(data.products)) {
                catalogProducts = data.products;
                // Sesuaikan batas stok item yang sedang ada di keranjang kasir
                cart.forEach(item => {
                    const updated = catalogProducts.find(p => p.sku === item.sku);
                    if (updated) {
                        item.maxStock = updated.availableStock;
                        item.price = updated.price;
                        item.name = updated.name;
                        if (item.qty > item.maxStock) {
                            item.qty = Math.max(0, item.maxStock);
                        }
                    }
                });
                cart = cart.filter(i => i.qty > 0);

                document.getElementById('sync-last-time').textContent = new Date().toLocaleTimeString('id-ID', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });

                renderCatalog();
                renderCart();

                if (data.type === 'NEW_PRODUCT_ADDED') {
                    showToast('Produk baru dari Gudang otomatis tampil di Katalog!', 'success');
                } else if (data.type === 'STOCK_UPDATED' || data.type === 'SHELF_REPLENISHED') {
                    showToast('Stok produk diperbarui otomatis dari Gudang.', 'info');
                }
            }
        };

        function requestWarehouseCatalog() {
            posSyncChannel.postMessage({ type: 'POS_REQUEST_CATALOG' });
            showToast('Meminta sinkronisasi data terbaru dari Gudang...', 'info');
        }

        // Kirim data penjualan kasir ke Gudang agar stok gudang & rak berkurang otomatis
        function notifyWarehouseOfSale(soldItems) {
            posSyncChannel.postMessage({
                type: 'POS_SALE_COMPLETED',
                timestamp: new Date().toISOString(),
                items: soldItems.map(item => ({
                    sku: item.sku,
                    qty: item.qty
                }))
            });
        }

        /**
         * 3. KATALOG VISUAL & SCAN BARCODE (BAGIAN C)
         */
        function formatRupiah(num) {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                minimumFractionDigits: 0
            }).format(num);
        }

        function setCatalogFilter(filterType) {
            catalogFilter = filterType;
            document.querySelectorAll('.cat-pill').forEach(btn => {
                btn.classList.remove('bg-agri-600', 'text-white', 'font-bold');
                btn.classList.add('bg-slate-100', 'text-slate-600', 'font-semibold');
            });
            const active = document.getElementById(`cat-${filterType}`);
            active.classList.add('bg-agri-600', 'text-white', 'font-bold');
            active.classList.remove('bg-slate-100', 'text-slate-600', 'font-semibold');
            renderCatalog();
        }

        function renderCatalog() {
            const query = document.getElementById('catalog-search-input').value.toLowerCase().trim();
            const grid = document.getElementById('visual-catalog-grid');

            const filtered = catalogProducts.filter(p => {
                const matchText = p.name.toLowerCase().includes(query) || p.sku.toLowerCase().includes(query);
                if (!matchText) return false;

                if (catalogFilter === 'available') return p.shelfStock > 0;
                if (catalogFilter === 'low') return p.shelfStock <= 5;
                return true;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full bg-white rounded-2xl border border-slate-200 p-10 text-center">
                        <i data-lucide="package-x" class="w-10 h-10 text-slate-300 mx-auto mb-2"></i>
                        <p class="text-sm font-bold text-slate-700">Produk tidak ditemukan di katalog</p>
                        <p class="text-xs text-slate-500 mt-1">Coba kata kunci lain atau pastikan Staff Gudang sudah menginput barang.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            grid.innerHTML = filtered.map(p => {
                const isOutOfStock = p.availableStock <= 0;
                const inCart = cart.find(c => c.sku === p.sku);

                return `
                <button type="button" onclick="addToCart('${p.sku}')" ${isOutOfStock ? 'disabled' : ''} class="group text-left bg-white rounded-2xl border ${inCart ? 'border-agri-500 ring-2 ring-agri-500/20' : 'border-slate-200/90'} shadow-sm hover:shadow-md hover:border-agri-400 disabled:opacity-60 disabled:cursor-not-allowed transition overflow-hidden flex flex-col justify-between relative">
                    
                    <!-- Quantity Badge if in cart -->
                    ${inCart ? `
                        <span class="absolute top-2.5 right-2.5 z-10 w-7 h-7 rounded-full bg-agri-600 text-white font-mono font-extrabold text-xs flex items-center justify-center shadow-md">
                            ${inCart.qty}
                        </span>
                    ` : ''}

                    <div>
                        <div class="relative h-32 sm:h-36 bg-slate-100 overflow-hidden">
                            <img src="${p.image}" alt="${p.name}" onerror="this.src='https://placehold.co/400x300/278b4d/ffffff?text=Produk+Tani'" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            <span class="absolute bottom-2 left-2 px-2 py-0.5 rounded-md bg-slate-900/75 backdrop-blur-sm text-white font-mono text-[10px] font-semibold">
                                ${p.sku}
                            </span>
                        </div>

                        <div class="p-3">
                            <h3 class="font-bold text-slate-900 text-xs sm:text-sm line-clamp-2 leading-snug">${p.name}</h3>
                            <p class="text-sm sm:text-base font-extrabold text-agri-700 font-mono mt-1.5">${formatRupiah(p.price)}</p>
                        </div>
                    </div>

                    <div class="px-3 pb-3 pt-1 flex items-center justify-between text-[11px] border-t border-slate-100">
                        <span class="text-slate-500">Rak: <strong class="font-mono ${p.shelfStock <= 5 ? 'text-amber-600' : 'text-slate-700'}">${p.shelfStock}</strong></span>
                        <span class="text-slate-500">Total: <strong class="font-mono ${isOutOfStock ? 'text-rose-600' : 'text-agri-700'}">${p.availableStock}</strong></span>
                    </div>
                </button>
                `;
            }).join('');

            lucide.createIcons();
        }

        function handleBarcodeScan(event) {
            event.preventDefault();
            const input = document.getElementById('barcode-scan-input');
            const code = input.value.trim();
            if (!code) return;

            const found = catalogProducts.find(p => p.sku.toLowerCase() === code.toLowerCase());
            if (!found) {
                showToast(`Kode khusus "${code}" tidak ditemukan!`, 'error');
                input.select();
                return;
            }

            addToCart(found.sku);
            input.value = '';
        }

        /**
         * 4. KERANJANG BELANJA & PERHITUNGAN TOTAL
         */
        function addToCart(sku) {
            const product = catalogProducts.find(p => p.sku === sku);
            if (!product) return;

            if (product.availableStock <= 0) {
                showToast(`Stok "${product.name}" sedang habis!`, 'error');
                return;
            }

            const existing = cart.find(item => item.sku === sku);
            if (existing) {
                if (existing.qty + 1 > product.availableStock) {
                    showToast(`Maksimal stok tersedia hanya ${product.availableStock} unit.`, 'warning');
                    return;
                }
                existing.qty += 1;
            } else {
                cart.push({
                    sku: product.sku,
                    name: product.name,
                    price: product.price,
                    image: product.image,
                    qty: 1,
                    maxStock: product.availableStock
                });
            }

            renderCatalog();
            renderCart();
        }

        function updateCartQty(sku, delta) {
            const index = cart.findIndex(item => item.sku === sku);
            if (index === -1) return;

            const item = cart[index];
            const newQty = item.qty + delta;

            if (newQty <= 0) {
                cart.splice(index, 1);
            } else if (newQty > item.maxStock) {
                showToast(`Stok gudang hanya tersisa ${item.maxStock} unit.`, 'warning');
                return;
            } else {
                item.qty = newQty;
            }

            renderCatalog();
            renderCart();
        }

        function clearCart() {
            cart = [];
            renderCatalog();
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items-container');
            const countEl = document.getElementById('cart-item-count');
            const clearBtn = document.getElementById('btn-clear-cart');
            const checkoutBtn = document.getElementById('btn-checkout');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            countEl.textContent = totalQty;

            if (cart.length === 0) {
                clearBtn.classList.add('hidden');
                checkoutBtn.disabled = true;
                container.innerHTML = `
                    <div class="py-10 text-center border-2 border-dashed border-slate-200 rounded-xl">
                        <i data-lucide="shopping-cart" class="w-8 h-8 text-slate-300 mx-auto mb-2"></i>
                        <p class="text-xs font-semibold text-slate-500">Keranjang belanja masih kosong</p>
                        <p class="text-[11px] text-slate-400 mt-0.5">Pilih barang dari katalog atau scan kode khusus</p>
                    </div>
                `;
                lucide.createIcons();
                recalculateTotals();
                return;
            }

            clearBtn.classList.remove('hidden');
            checkoutBtn.disabled = false;

            container.innerHTML = cart.map(item => `
                <div class="flex items-center justify-between gap-2.5 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80">
                    <img src="${item.image}" alt="${item.name}" class="w-11 h-11 rounded-lg object-cover border border-slate-200 flex-shrink-0">
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-bold text-slate-900 truncate">${item.name}</p>
                        <p class="text-[11px] font-mono text-agri-700 font-semibold">${formatRupiah(item.price)} &times; ${item.qty}</p>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button type="button" onclick="updateCartQty('${item.sku}', -1)" class="w-7 h-7 rounded-lg bg-white border border-slate-300 hover:bg-slate-100 flex items-center justify-center font-bold text-slate-700">-</button>
                        <span class="w-6 text-center font-mono text-xs font-extrabold">${item.qty}</span>
                        <button type="button" onclick="updateCartQty('${item.sku}', 1)" class="w-7 h-7 rounded-lg bg-agri-600 hover:bg-agri-700 text-white flex items-center justify-center font-bold">+</button>
                    </div>
                </div>
            `).join('');

            lucide.createIcons();
            recalculateTotals();
        }

        function getCalculationSummary() {
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const discountPercent = Math.min(100, Math.max(0, Number(document.getElementById('discount-percent-input').value) || 0));
            const discountAmount = Math.round(subtotal * (discountPercent / 100));
            const afterDiscount = Math.max(0, subtotal - discountAmount);
            const includeTax = document.getElementById('tax-toggle').checked;
            const taxAmount = includeTax ? Math.round(afterDiscount * 0.11) : 0;
            const grandTotal = afterDiscount + taxAmount;

            return { subtotal, discountPercent, discountAmount, taxAmount, grandTotal };
        }

        function recalculateTotals() {
            const { subtotal, discountAmount, taxAmount, grandTotal } = getCalculationSummary();
            document.getElementById('summary-subtotal').textContent = formatRupiah(subtotal);
            document.getElementById('summary-discount').textContent = `- ${formatRupiah(discountAmount)}`;
            document.getElementById('summary-tax').textContent = formatRupiah(taxAmount);
            document.getElementById('summary-grand-total').textContent = formatRupiah(grandTotal);
        }

        /**
         * 5. CRM PELANGGAN (MEMBER / BARU / LEWATI)
         */
        function openCrmModal() {
            renderCustomerList();
            document.getElementById('crm-modal').classList.remove('hidden');
        }

        function closeCrmModal() {
            document.getElementById('crm-modal').classList.add('hidden');
        }

        function renderCustomerList() {
            const q = document.getElementById('crm-search-input').value.toLowerCase().trim();
            const container = document.getElementById('crm-member-list');

            const list = crmCustomers.filter(c =>
                c.name.toLowerCase().includes(q) ||
                c.phone.includes(q) ||
                c.id.toLowerCase().includes(q)
            );

            container.innerHTML = list.map(c => `
                <div onclick="selectCustomer('${c.id}')" class="p-3 rounded-xl border border-slate-200 hover:border-agri-500 hover:bg-agri-50/50 cursor-pointer flex items-center justify-between transition">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-xs text-slate-900">${c.name}</span>
                            <span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-800 rounded">Diskon ${c.discount}%</span>
                        </div>
                        <p class="text-[11px] text-slate-500 font-mono mt-0.5">${c.phone} &bull; ${c.points} Poin</p>
                    </div>
                    <span class="text-xs font-bold text-agri-700">Pilih &rarr;</span>
                </div>
            `).join('');
        }

        function selectCustomer(id) {
            const cust = crmCustomers.find(c => c.id === id);
            if (!cust) return;

            selectedCustomer = cust;
            document.getElementById('crm-avatar').textContent = cust.name.substring(0, 2).toUpperCase();
            document.getElementById('crm-avatar').className = 'w-9 h-9 rounded-full bg-agri-600 text-white flex items-center justify-center font-bold text-xs flex-shrink-0';
            document.getElementById('crm-name').textContent = cust.name;
            document.getElementById('crm-badge').classList.remove('hidden');
            document.getElementById('crm-phone').textContent = `WA: ${cust.phone} • Diskon Member ${cust.discount}%`;

            // Terapkan diskon member otomatis
            document.getElementById('discount-percent-input').value = cust.discount;
            recalculateTotals();
            closeCrmModal();
            showToast(`Member "${cust.name}" dipilih (Diskon ${cust.discount}% aktif).`, 'success');
        }

        function selectGuestCustomer() {
            selectedCustomer = null;
            document.getElementById('crm-avatar').textContent = 'UM';
            document.getElementById('crm-avatar').className = 'w-9 h-9 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs flex-shrink-0';
            document.getElementById('crm-name').textContent = 'Pelanggan Umum (Lewati)';
            document.getElementById('crm-badge').classList.add('hidden');
            document.getElementById('crm-phone').textContent = 'Tanpa diskon khusus member';
            document.getElementById('discount-percent-input').value = 0;
            recalculateTotals();
            closeCrmModal();
        }

        function handleRegisterCustomer(event) {
            event.preventDefault();
            const name = document.getElementById('new-cust-name').value.trim();
            const phone = document.getElementById('new-cust-phone').value.trim();
            const address = document.getElementById('new-cust-address').value.trim();

            const newMember = {
                id: 'MBR-' + Math.floor(100 + Math.random() * 900),
                name,
                phone,
                address,
                isMember: true,
                discount: 5, // Diskon member baru 5%
                points: 50
            };

            crmCustomers.unshift(newMember);
            selectCustomer(newMember.id);
            event.target.reset();
            showToast(`Pelanggan baru "${name}" terdaftar ke database CRM!`, 'success');
        }

        /**
         * 6. PROSES PEMBAYARAN (TUNAI & PAYMENT GATEWAY)
         */
        function openPaymentModal() {
            if (cart.length === 0) return;
            const { grandTotal } = getCalculationSummary();
            document.getElementById('pay-modal-total').textContent = formatRupiah(grandTotal);
            document.getElementById('cash-received-input').value = grandTotal;
            switchPaymentMethod('cash');
            calculateChange();
            document.getElementById('payment-modal').classList.remove('hidden');
        }

        function closePaymentModal() {
            document.getElementById('payment-modal').classList.add('hidden');
        }

        function switchPaymentMethod(method) {
            const cashTab = document.getElementById('pay-tab-cash');
            const gwTab = document.getElementById('pay-tab-gateway');
            const cashSec = document.getElementById('payment-cash-section');
            const gwSec = document.getElementById('payment-gateway-section');

            if (method === 'cash') {
                cashTab.className = 'p-3 rounded-xl border-2 border-agri-600 bg-agri-50 text-agri-900 font-bold text-xs flex flex-col items-center gap-1.5 transition';
                gwTab.className = 'p-3 rounded-xl border-2 border-slate-200 bg-white text-slate-600 font-bold text-xs flex flex-col items-center gap-1.5 transition';
                cashSec.classList.remove('hidden');
                gwSec.classList.add('hidden');
            } else {
                gwTab.className = 'p-3 rounded-xl border-2 border-sky-600 bg-sky-50 text-sky-950 font-bold text-xs flex flex-col items-center gap-1.5 transition';
                cashTab.className = 'p-3 rounded-xl border-2 border-slate-200 bg-white text-slate-600 font-bold text-xs flex flex-col items-center gap-1.5 transition';
                gwSec.classList.remove('hidden');
                cashSec.classList.add('hidden');
            }
        }

        function setExactCash() {
            const { grandTotal } = getCalculationSummary();
            document.getElementById('cash-received-input').value = grandTotal;
            calculateChange();
        }

        function addCashAmount(amount) {
            const input = document.getElementById('cash-received-input');
            input.value = (Number(input.value) || 0) + amount;
            calculateChange();
        }

        function calculateChange() {
            const { grandTotal } = getCalculationSummary();
            const received = Number(document.getElementById('cash-received-input').value) || 0;
            const change = received - grandTotal;
            const display = document.getElementById('cash-change-display');
            const btn = document.getElementById('btn-confirm-cash');

            if (change < 0) {
                display.textContent = `Kurang ${formatRupiah(Math.abs(change))}`;
                display.className = 'text-base font-extrabold font-mono text-rose-600';
                btn.disabled = true;
                btn.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                display.textContent = formatRupiah(change);
                display.className = 'text-base font-extrabold font-mono text-agri-700';
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        }

        function simulateGatewayVerification() {
            const btn = document.getElementById('btn-verify-gateway');
            btn.disabled = true;
            btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> <span>Memverifikasi Pembayaran...</span>`;
            lucide.createIcons();

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = `<i data-lucide="shield-check" class="w-4 h-4"></i> <span>Verifikasi Otomatis & Selesaikan</span>`;
                lucide.createIcons();
                completeTransaction('Non-Tunai (QRIS / Gateway)');
            }, 900);
        }

        /**
         * 7. PENYELESAIAN TRANSAKSI: POTONG STOK GUDANG, CETAK STRUK & NOTIFIKASI WA
         */
        function completeTransaction(paymentMethod) {
            const summary = getCalculationSummary();
            const paidAmount = paymentMethod === 'Tunai'
                ? Number(document.getElementById('cash-received-input').value)
                : summary.grandTotal;
            const changeAmount = Math.max(0, paidAmount - summary.grandTotal);

            // 1. Kurangi stok lokal & kirim sinyal ke Sistem Gudang (Real-Time)
            cart.forEach(sold => {
                const prod = catalogProducts.find(p => p.sku === sold.sku);
                if (prod) {
                    prod.availableStock = Math.max(0, prod.availableStock - sold.qty);
                    prod.shelfStock = Math.max(0, prod.shelfStock - sold.qty);
                }
            });
            notifyWarehouseOfSale(cart);

            // 2. Buat objek struk transaksi
            const txId = 'INV-' + Date.now().toString().slice(-6);
            const txTime = new Date().toLocaleString('id-ID');
            const customerName = selectedCustomer ? selectedCustomer.name : 'Pelanggan Umum';
            const customerPhone = selectedCustomer ? selectedCustomer.phone : null;

            const receiptData = {
                txId,
                txTime,
                customerName,
                customerPhone,
                paymentMethod,
                items: [...cart],
                ...summary,
                paidAmount,
                changeAmount
            };

            lastCompletedReceipt = receiptData;
            transactionHistory.unshift(receiptData);
            document.getElementById('tx-history-count').textContent = transactionHistory.length;

            // 3. Tampilkan Struk & Status Notifikasi WhatsApp Otomatis
            populateReceiptModal(receiptData);
            closePaymentModal();
            document.getElementById('receipt-modal').classList.remove('hidden');

            // Reset keranjang untuk transaksi berikutnya
            clearCart();
        }

        function populateReceiptModal(data) {
            document.getElementById('receipt-tx-id').textContent = data.txId;
            document.getElementById('receipt-date').textContent = data.txTime;
            document.getElementById('receipt-customer').textContent = data.customerName;
            document.getElementById('receipt-method').textContent = data.paymentMethod;

            document.getElementById('receipt-items-list').innerHTML = data.items.map(item => `
                <div class="flex justify-between">
                    <span>${item.name} (${item.qty}x)</span>
                    <span>${formatRupiah(item.price * item.qty)}</span>
                </div>
            `).join('');

            document.getElementById('receipt-subtotal').textContent = formatRupiah(data.subtotal);
            document.getElementById('receipt-discount').textContent = `- ${formatRupiah(data.discountAmount)}`;
            document.getElementById('receipt-tax').textContent = formatRupiah(data.taxAmount);
            document.getElementById('receipt-total').textContent = formatRupiah(data.grandTotal);
            document.getElementById('receipt-paid').textContent = formatRupiah(data.paidAmount);
            document.getElementById('receipt-change').textContent = formatRupiah(data.changeAmount);

            const waDetail = document.getElementById('whatsapp-status-detail');
            if (data.customerPhone) {
                const earnedPts = Math.floor(data.grandTotal / 10000);
                waDetail.innerHTML = `Terkirim ke <strong>${data.customerPhone}</strong>: <em>"Terima kasih ${data.customerName}, transaksi ${data.txId} sebesar ${formatRupiah(data.grandTotal)} berhasil! Anda mendapat +${earnedPts} poin tani."</em>`;
            } else {
                waDetail.textContent = 'Pelanggan Umum (tanpa nomor WA terdaftar). Struk fisik siap dicetak.';
            }
        }

        function sendWhatsAppManual() {
            if (!lastCompletedReceipt) return;
            const phone = lastCompletedReceipt.customerPhone || '081200000000';
            showToast(`Pesan struk digital dikirim ulang ke WhatsApp (${phone}).`, 'success');
        }

        function closeReceiptModal() {
            document.getElementById('receipt-modal').classList.add('hidden');
        }

        /**
         * 8. RIWAYAT TRANSAKSI & TOAST
         */
        function openHistoryModal() {
            const container = document.getElementById('history-list-container');
            if (transactionHistory.length === 0) {
                container.innerHTML = `<p class="text-center text-xs text-slate-400 py-8">Belum ada transaksi dilakukan pada sesi ini.</p>`;
            } else {
                container.innerHTML = transactionHistory.map(tx => `
                    <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-between gap-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-bold text-xs text-agri-800">${tx.txId}</span>
                                <span class="px-2 py-0.5 rounded bg-agri-100 text-agri-800 text-[10px] font-bold">${tx.paymentMethod}</span>
                            </div>
                            <p class="text-xs font-bold text-slate-900 mt-1">${tx.customerName}</p>
                            <p class="text-[11px] text-slate-500">${tx.txTime} &bull; ${tx.items.length} jenis barang</p>
                        </div>
                        <div class="text-right">
                            <p class="font-mono font-extrabold text-sm text-agri-700">${formatRupiah(tx.grandTotal)}</p>
                            <span class="text-[10px] text-emerald-600 font-semibold">Stok Gudang Terpotong</span>
                        </div>
                    </div>
                `).join('');
            }
            document.getElementById('history-modal').classList.remove('hidden');
        }

        function closeHistoryModal() {
            document.getElementById('history-modal').classList.add('hidden');
        }

        function showToast(message, variant = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');

            const styles = {
                success: 'bg-agri-900 text-white border-agri-700',
                info: 'bg-sky-900 text-white border-sky-700',
                warning: 'bg-amber-500 text-slate-950 border-amber-600 font-semibold',
                error: 'bg-rose-600 text-white border-rose-700'
            };

            const icons = {
                success: 'check-circle-2',
                info: 'refresh-cw',
                warning: 'alert-triangle',
                error: 'alert-circle'
            };

            toast.className = `pointer-events-auto p-3.5 rounded-xl border shadow-lg flex items-center gap-2.5 text-xs transition-all duration-300 ${styles[variant] || styles.success}`;
            toast.innerHTML = `
                <i data-lucide="${icons[variant] || 'info'}" class="w-4 h-4 flex-shrink-0"></i>
                <span class="flex-1 leading-snug">${message}</span>
            `;

            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(8px)';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Initialize on Window Load
        window.onload = function() {
            lucide.createIcons();
            renderCatalog();
            renderCart();
            requestWarehouseCatalog();
        };
    </script>
</body>
</html>
